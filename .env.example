# Required. PostgreSQL connection used by Prisma CLI and the app.
# Production must use a hosted PostgreSQL database with TLS enabled as required by the provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habitix?schema=public"

# Required. Generate a unique value with at least 32 characters for every environment.
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"

# Required. Public origin of this deployment, without a trailing slash.
# Example: https://habitix.example.com
BETTER_AUTH_URL="http://localhost:3000"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional. Prisma seed creates only required badge definitions by default.
# Set to true only for disposable local or preview databases.
SEED_DEMO_DATA="false"
