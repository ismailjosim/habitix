# PostgreSQL connection used by Prisma CLI and the app.
# Replace the username, password, host, port, and database name with your local or hosted PostgreSQL values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habitix?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
